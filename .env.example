# Ollama 서버 및 모델 설정 (전극 검사기 Agent + 기존 사양서 생성기 공용)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
EMBEDDING_MODEL=bge-m3

# /api/generate 구조화 출력 호출의 read timeout(초). 느린 하드웨어나 reasoning
# 모델(deepseek-r1 등) 사용 시 늘려야 할 수 있다. 비워두면 기본값 180을 쓴다.
# OLLAMA_TIMEOUT=180

# 웹 서버 포트 (main.py를 python main.py로 직접 실행할 때 사용)
AGENT_PORT=8000

# 로그 레벨 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 필요 시 Vector DB / 템플릿 경로도 오버라이드 가능
# CHROMA_DB_PATH=./chroma_db_specs
# ELECTRODE_TEMPLATE_PATH=./template_electrode.pptx

# ------------------------------------------------------------------
# PPTX Renderer: 회사 지정 PPT 템플릿 경로 (선택 사항)
# ------------------------------------------------------------------
# PPTX Template 파일에는 회사 기밀정보(로고, 표준 양식 등)가 포함될 수 있으므로
# 이 저장소에는 절대 커밋하지 않는다. 회사 PC의 로컬 경로를 지정하면
# renderers/pptx_renderer.py가 그 템플릿을 사용하고, 비워두면 템플릿 없이도
# 기본 PPTX가 코드로 생성된다(Agent 파이프라인은 템플릿 유무와 무관하게 항상 동작).
#
# Windows 예시:
# PPT_TEMPLATE_PATH=C:\Company\Templates\electrode_spec.pptx
#
# PPT_TEMPLATE_PATH=
